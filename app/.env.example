# Configure secrets in the hosting environment or ignored .dev.vars. Never put values in client code or commit them.
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible HTTPS endpoint, defaults to https://api.openai.com/v1
AI_BASE_URL=

# 64 hex characters (32 bytes). Enables AES-256-GCM at-rest encryption for private context and request notes.
# Generate locally: openssl rand -hex 32
# This is not end-to-end encryption. The server can decrypt for the signed-in owner.
CONTEXT_ENCRYPTION_KEY=

# Optional LiveKit. Without these, paired people can still use a browser-to-browser call through Saath signaling.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# PAYMENT_WEBHOOK_SECRET=
